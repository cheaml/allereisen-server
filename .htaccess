# atlas — statische Auslieferung auf Apache / DomainFactory
DirectoryIndex index.html

<IfModule mod_autoindex.c>
  Options -Indexes
</IfModule>

<IfModule mod_headers.c>
  # Die App und ihre lokalen Daten dürfen nicht aus einem alten Browsercache stammen.
  <FilesMatch "\.(html|js)$">
    Header set Cache-Control "no-cache, no-store, must-revalidate"
  </FilesMatch>
  Header always set X-Content-Type-Options "nosniff"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set Permissions-Policy "geolocation=(), camera=(), microphone=()"
  Header always set Strict-Transport-Security "max-age=31536000"
  Header always set Content-Security-Policy "default-src 'self'; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com https://unpkg.com; font-src https://fonts.gstatic.com; img-src 'self' data: blob: https://images.unsplash.com https://server.arcgisonline.com https://*.tile.openstreetmap.org; connect-src 'self' https://graph.microsoft.com https://login.microsoftonline.com https://overpass-api.de; script-src 'self' 'wasm-unsafe-eval' https://unpkg.com; worker-src 'self' blob:; base-uri 'self'; form-action 'self'; frame-ancestors 'none'"
</IfModule>

<FilesMatch "\.(?:md|sql)$">
  Require all denied
</FilesMatch>
